{
  "name": "SubGuard Test",
  "short_name": "SubGuard",
  "description": "Minimal TypeScript PWA for validating offline behavior on GitHub Pages and iOS Safari.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#020617",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icons/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
